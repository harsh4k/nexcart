# Firebase web app config (Firebase console -> Project settings -> Your apps).
# These values are public by design; access is controlled by firestore.rules and storage.rules.
# Set all of them or none: if VITE_FIREBASE_PROJECT_ID is unset, the app uses
# firebase-applet-config.json (the original AI Studio project) instead.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Named Firestore database, if any. Leave empty for the (default) database.
# The AI Studio project's data lives in the named database listed in firebase-applet-config.json.
VITE_FIRESTORE_DATABASE_ID=""
