# Firebase web app config (Firebase console -> Project settings -> Your apps).
# These values are public by design; access is controlled by firestore.rules and storage.rules.
# If VITE_FIREBASE_PROJECT_ID is unset, the app falls back to firebase-applet-config.json.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Optional: a named Firestore database. Leave empty for the (default) database.
VITE_FIRESTORE_DATABASE_ID=""
