# MONGODB_URI: Connection string for MongoDB (optional).
# Without it, the dev server serves a built-in mock catalog.
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/nexcart
MONGODB_URI=""

# VITE_API_URL: Base URL for the API (optional, defaults to same origin).
# Example: https://my-api.vercel.app
VITE_API_URL=""
